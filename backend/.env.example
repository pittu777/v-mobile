# Server
PORT=3000
NODE_ENV=development

# Database
MONGO_URL=mongodb://127.0.0.1:27017/my-mobile-app

# Auth
# Must be at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_at_least_32_random_characters
JWT_EXPIRES_IN=604800
JWT_ISSUER=mymobileapp-api

# Where verification / reset links point (the app or web origin).
# Use your LAN IP on a physical device, e.g. http://192.168.1.20:8081
APP_BASE_URL=http://localhost:8081

# CORS — comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:8081

# Mail (leave blank in development: emails are logged to the console instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MyMobileApp <no-reply@mymobileapp.local>